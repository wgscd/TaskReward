<UserControl x:Class="TaskReward.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <!-- 标题 -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="积分商城" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="用努力换来的积分，兑换属于自己的小奖励" Foreground="{StaticResource BrushSub}" FontSize="14" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#FFF6E5" CornerRadius="12" Padding="14,7" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#C77B00" FontSize="14" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="⭐ 可用 {0} 分">
                                    <Binding Path="PointsText"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    <Button Content="＋ 管理商品" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 商品网格 -->
            <ItemsControl ItemsSource="{Binding Products}" Margin="0,18,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="20,18">
                            <StackPanel>
                                <Grid>
                                    <Border Width="58" Height="58" CornerRadius="15" Background="#F0F1FB" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Icon}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="✎" Width="30" Height="30" FontSize="12" Background="#E9ECFD" Margin="0,0,4,0"
                                                Style="{StaticResource BaseButton}" ToolTip="编辑商品"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="🗑" Width="30" Height="30" FontSize="12" Background="#FDEEEE"
                                                Style="{StaticResource BaseButton}" ToolTip="删除商品"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource BrushSub}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Height="40"/>

                                <Grid Margin="0,16,0,0">
                                    <Border Background="#FFF6E5" CornerRadius="10" Padding="12,5" HorizontalAlignment="Left">
                                        <TextBlock Foreground="#D97B00" FontSize="14" FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} 积分">
                                                    <Binding Path="Cost"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <Button Content="兑换" Style="{StaticResource GoldButton}" Padding="16,7" HorizontalAlignment="Right"
                                            Command="{Binding DataContext.RedeemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource BrushSub}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="库存：{0}">
                                            <Binding Path="Stock" Converter="{StaticResource StockTextConverter}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 兑换历史 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="🧾 兑换记录" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Foreground="{StaticResource BrushSub}" FontSize="12" Margin="0,4,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="历史累计消费 {0} 积分">
                                        <Binding Path="SpentText"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding History}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Icon}" FontSize="20" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProductName}" Foreground="{StaticResource BrushText}" FontSize="14"
                                               VerticalAlignment="Center" Margin="10,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Foreground="#D97B00" FontSize="13" FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="-{0} 分">
                                                    <Binding Path="Cost"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:MM-dd HH:mm}}" Foreground="{StaticResource BrushSub}" FontSize="12" Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="还没有兑换记录，攒够积分就来看看吧～" Foreground="{StaticResource BrushSub}" FontSize="13" Margin="0,12,0,0"
                               Visibility="{Binding History.Count, Converter={StaticResource ZeroToVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
