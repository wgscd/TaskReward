<UserControl x:Class="TaskReward.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <!-- 标题行 -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="我的任务" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="添加任务、打勾完成，赢得积分奖励" Foreground="{StaticResource BrushSub}" FontSize="14" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#FFF6E5" CornerRadius="12" Padding="14,7" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#C77B00" FontSize="14" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="⭐ 可用 {0} 分">
                                    <Binding Path="PointsText"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    <Button Content="＋ 新建任务" Style="{StaticResource PrimaryButton}" Command="{Binding AddTaskCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 模板快速添加 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="📁 任务模板库（点击卡片快速添加）" Style="{StaticResource SectionTitle}"/>
                        <Button Content="＋ 新建模板" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                Command="{Binding AddTemplateCommand}"/>
                    </Grid>

                    <ScrollViewer Margin="0,12,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="92">
                        <ItemsControl ItemsSource="{Binding Templates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TemplateCard}" Margin="0,0,12,0" Width="210">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="12" Background="#F0F1FB" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="#D97B00" FontSize="13" FontWeight="Bold" Margin="0,3,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="+{0} 分">
                                                            <Binding Path="Points"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <Button Content="＋" Width="26" Height="26" FontSize="15" Background="#E9ECFD" Margin="0,0,4,0"
                                                        Style="{StaticResource BaseButton}" ToolTip="添加到我的任务"
                                                        Command="{Binding DataContext.AddFromTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="✎" Width="26" Height="26" FontSize="12" Background="#E9ECFD" Margin="0,0,4,0"
                                                        Style="{StaticResource BaseButton}" ToolTip="编辑模板"
                                                        Command="{Binding DataContext.EditTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="🗑" Width="26" Height="26" FontSize="12" Background="#FDEEEE"
                                                        Style="{StaticResource BaseButton}" ToolTip="删除模板"
                                                        Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 任务列表 -->
            <StackPanel Margin="0,18,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="任务清单" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Foreground="{StaticResource BrushSub}" FontSize="13" Margin="0,4,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="已完成 {0} 项">
                                    <Binding Path="TaskDoneText"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 完成切换 -->
                                    <Button Grid.Column="0" Width="44" Height="44"
                                            Background="#EFF0FA" ToolTip="完成 / 取消完成"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                                <Setter Property="Background" Value="#EFF0FA"/>
                                                <Setter Property="Content" Value="◯"/>
                                                <Setter Property="FontSize" Value="22"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushSub}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Completed}" Value="True">
                                                        <Setter Property="Background" Value="#E4F7EC"/>
                                                        <Setter Property="Content" Value="✓"/>
                                                        <Setter Property="Foreground" Value="#1FA35C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- 图标 -->
                                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="13" Background="#F0F1FB" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- 名称描述 -->
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                                            <Border Background="#F0E8FB" CornerRadius="5" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding FromTemplate, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="模板" FontSize="11" Foreground="#8E54D4"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource BrushSub}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                                    </StackPanel>

                                    <!-- 积分 + 操作 -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#FFF6E5" CornerRadius="10" Padding="12,5" HorizontalAlignment="Right">
                                            <TextBlock Foreground="#D97B00" FontSize="14" FontWeight="Bold">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="+{0} 分">
                                                        <Binding Path="Points"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="✎" Style="{StaticResource IconButton}" ToolTip="编辑"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="🗑" Style="{StaticResource DangerIconButton}" ToolTip="删除"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="40,34" Visibility="{Binding Tasks.Count, Converter={StaticResource ZeroToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🌱" FontSize="44" HorizontalAlignment="Center"/>
                        <TextBlock Text="还没有任务，快点击右上角「新建任务」开始吧！" Foreground="{StaticResource BrushSub}" FontSize="14" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
