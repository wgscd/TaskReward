<UserControl x:Class="TaskReward.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <!-- 标题 -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="我的成就" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="坚持付出，历史积分越高，成就越闪耀" Foreground="{StaticResource BrushSub}" FontSize="14" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Background="#FFF6E5" CornerRadius="12" Padding="14,7" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Foreground="#C77B00" FontSize="14" FontWeight="Bold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="🔥 历史累计 {0} 分">
                                <Binding Path="LifetimeText"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Border>
            </Grid>

            <!-- 总进度 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource BrushText}" FontSize="14" FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="成就解锁进度  {0} 枚">
                                    <Binding Path="UnlockedText"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" Style="{StaticResource GoldProgress}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding OverallProgress, StringFormat={}{0:0}%}" FontSize="26" FontWeight="Bold"
                               Foreground="#D97B00" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </Grid>
            </Border>

            <!-- 成就网格 -->
            <ItemsControl ItemsSource="{Binding Achievements}" Margin="0,18,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="20,18"
                                Opacity="{Binding IsUnlocked, Converter={StaticResource LockedOpacity}}">
                            <StackPanel>
                                <!-- 徽章 -->
                                <Grid>
                                    <Border Width="66" Height="66" CornerRadius="18" HorizontalAlignment="Center"
                                            Background="{Binding Tier, Converter={StaticResource TierBrush}}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.30" Color="#8E54D4"/>
                                        </Border.Effect>
                                        <TextBlock Text="{Binding Icon}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#E4F7EC" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="🔓 已解锁" FontSize="11" Foreground="#1FA35C"/>
                                    </Border>
                                    <TextBlock Text="🔒" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Visibility="{Binding IsUnlocked, Converter={StaticResource InvBoolToVis}}"/>
                                </Grid>

                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushText}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource BrushSub}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                <Border Background="#F4F5FB" CornerRadius="8" Padding="10,4" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock FontSize="11" Foreground="{StaticResource BrushSub}">历史累计积分</TextBlock>
                                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Right">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} / {1:0}">
                                                        <Binding Path="DataContext.LifetimeText" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="Threshold"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Height="6" Margin="0,6,0,0" Background="#E8EAF7"
                                                     Foreground="#F5A623"
                                                     Value="{Binding Progress, Mode=OneWay}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
