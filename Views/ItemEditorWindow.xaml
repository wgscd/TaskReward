<Window x:Class="TaskReward.Views.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑" x:Name="Root"
        Width="560" Height="Auto" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F6F7FD" WindowStyle="None" AllowsTransparency="True"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Border CornerRadius="18" Background="White" BorderBrush="#E4E6F5" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.22" Color="#1B1E4B"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Background="#F0F1FB" CornerRadius="18,18,0,0" Padding="22,16">
                <Grid>
                    <TextBlock Text="{Binding ItemTitle, ElementName=Root}" FontSize="18" FontWeight="Bold" Foreground="#23263F" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="34" Height="34"
                            Background="#E4E6F5" Cursor="Hand" FontSize="13" Foreground="#5A5FA0"
                            Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,18,24,24">
                <!-- 图标选择 -->
                <TextBlock Text="选择图标" FontSize="13" Foreground="#8A8FA8" Margin="0,0,0,8"/>
                <ItemsControl x:Name="IconGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource IconPickButton}" Tag="{Binding}" Checked="Icon_Checked"
                                         GroupName="iconpick"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 名称 -->
                <TextBlock Text="名称" FontSize="13" Foreground="#8A8FA8" Margin="0,16,0,8"/>
                <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding ItemName, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>

                <!-- 描述 -->
                <TextBlock Text="描述" FontSize="13" Foreground="#8A8FA8" Margin="0,16,0,8"/>
                <TextBox Style="{StaticResource MultilineTextBox}" Text="{Binding Description, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>

                <!-- 积分 -->
                <TextBlock Text="奖励积分" FontSize="13" Foreground="#8A8FA8" Margin="0,16,0,8"/>
                <TextBox Style="{StaticResource TextBoxStyle}" Text="{Binding PointsText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         Width="140" HorizontalAlignment="Left" PreviewTextInput="Points_PreviewTextInput"/>

                <!-- 操作 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Margin="0,0,12,0" Click="Cancel_Click"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
