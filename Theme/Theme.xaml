<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:TaskReward.Converters">

    <!--  ============ 调色板 ============  -->
    <Color x:Key="PrimaryColor">#5B5FE0</Color>
    <Color x:Key="PrimaryDeep">#4648C4</Color>
    <Color x:Key="VioletColor">#8E54D4</Color>
    <Color x:Key="GoldColor">#F5B301</Color>
    <Color x:Key="BgColor">#F3F4FB</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="TextMain">#23263F</Color>
    <Color x:Key="TextSub">#8A8FA8</Color>
    <Color x:Key="LineColor">#ECEEF6</Color>
    <Color x:Key="SidebarTop">#2B2E66</Color>
    <Color x:Key="SidebarBottom">#412F86</Color>
    <Color x:Key="DangerColor">#E5484D</Color>
    <Color x:Key="SuccessColor">#2FB56C</Color>

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="BrushPrimaryDeep" Color="{StaticResource PrimaryDeep}" />
    <SolidColorBrush x:Key="BrushViolet" Color="{StaticResource VioletColor}" />
    <SolidColorBrush x:Key="BrushGold" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="BrushBg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BrushText" Color="{StaticResource TextMain}" />
    <SolidColorBrush x:Key="BrushSub" Color="{StaticResource TextSub}" />
    <SolidColorBrush x:Key="BrushLine" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource SuccessColor}" />

    <LinearGradientBrush x:Key="GradPrimary" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6A6FE8" />
        <GradientStop Offset="1" Color="#8E54D4" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradGold" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFC84A" />
        <GradientStop Offset="1" Color="#F5A623" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GradSidebar" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource SidebarTop}" />
        <GradientStop Offset="1" Color="{StaticResource SidebarBottom}" />
    </LinearGradientBrush>

    <!--  卡片阴影  -->
    <DropShadowEffect
        x:Key="CardShadow"
        BlurRadius="22"
        Opacity="0.10"
        ShadowDepth="4"
        Color="#1B1E4B" />
    <DropShadowEffect
        x:Key="SmallShadow"
        BlurRadius="14"
        Opacity="0.08"
        ShadowDepth="2"
        Color="#1B1E4B" />
    <DropShadowEffect
        x:Key="ButtonShadow"
        BlurRadius="10"
        Opacity="0.16"
        ShadowDepth="2"
        Color="#4B35A8" />

    <!--  ============ 转换器资源 ============  -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    <conv:ZeroToVisibilityConverter x:Key="ZeroToVis" />
    <conv:LockedOpacityConverter x:Key="LockedOpacity" />
    <conv:TierToBrushConverter x:Key="TierBrush" />
    <conv:StockTextConverter x:Key="StockTextConverter" />
    <conv:AchProgressMultiConverter x:Key="AchProgress" />
    <conv:ClampConverter x:Key="Clamp" />

    <!--  ============ 基础文本 ============  -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
    </Style>

    <!--  ============ 按钮 ============  -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="PrimaryButton"
        BasedOn="{StaticResource BaseButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GradPrimary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
    </Style>

    <Style
        x:Key="GoldButton"
        BasedOn="{StaticResource BaseButton}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GradGold}" />
        <Setter Property="Foreground" Value="#4A3200" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,10" />
    </Style>

    <Style
        x:Key="GhostButton"
        BasedOn="{StaticResource BaseButton}"
        TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource BrushPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,9" />
    </Style>

    <Style
        x:Key="IconButton"
        BasedOn="{StaticResource BaseButton}"
        TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="#F1F2FA" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style
        x:Key="DangerIconButton"
        BasedOn="{StaticResource IconButton}"
        TargetType="Button">
        <Setter Property="Background" Value="#FDEEEE" />
    </Style>

    <!--  ============ 输入框 ============  -->
    <Style x:Key="TextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#F7F8FD" />
        <Setter Property="Foreground" Value="{StaticResource BrushText}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter TargetName="bd" Property="Background" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#C9CBF2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="MultilineTextBox"
        BasedOn="{StaticResource TextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="70" />
    </Style>

    <!--  ============ 卡片 ============  -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushCard}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
    </Style>

    <!--  ============ 滚动条 ============  -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style TargetType="Thumb">
        <Setter Property="Background" Value="#D4D6EA" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        Margin="2"
                        Background="{TemplateBinding Background}"
                        CornerRadius="5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!--  ============ 进度条 ============  -->
    <Style x:Key="GoldProgress" TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="#EFF0FA" />
        <Setter Property="Foreground" Value="{StaticResource GradGold}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  侧栏导航按钮  -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#C7C9E8" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="bd"
                        Margin="10,3"
                        Padding="14,0"
                        CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ico"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Text="{TemplateBinding Tag}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{TemplateBinding Content}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#55FFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  图标选择项  -->
    <Style x:Key="IconPickButton" TargetType="RadioButton">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="bd"
                        Width="46"
                        Height="46"
                        Background="#F2F3FA"
                        CornerRadius="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Text="{TemplateBinding Tag}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E6E8FB" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#DDDEFAFF" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="2.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  模板选择卡片  -->
    <Style x:Key="TemplateCard" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushLine}" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Effect" Value="{StaticResource SmallShadow}" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
</ResourceDictionary>
