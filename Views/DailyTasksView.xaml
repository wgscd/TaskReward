<UserControl x:Class="TaskReward.Views.DailyTasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <!-- 标题 -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="每日任务" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="每天设置几个小目标，完成后打勾即可获得积分" Foreground="{StaticResource BrushSub}" FontSize="14" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#FFF6E5" CornerRadius="12" Padding="14,7" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Foreground="#C77B00" FontSize="14" FontWeight="Bold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="⭐ 可用 {0} 分">
                                    <Binding Path="PointsText"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </Border>
                    <Button Content="＋ 添加每日任务" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 日期导航 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="‹" Width="42" Height="42" Style="{StaticResource IconButton}" FontSize="22"
                                Command="{Binding PrevCommand}"/>
                        <Button Content="{Binding DateText}" Width="260" Height="42" Style="{StaticResource BaseButton}"
                                Background="#F0F1FB" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"
                                Margin="10,0" ToolTip="回到今天" Command="{Binding TodayCommand}"/>
                        <Button Content="›" Width="42" Height="42" Style="{StaticResource IconButton}" FontSize="22"
                                Command="{Binding NextCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DoneText}" Foreground="{StaticResource BrushSub}" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <!-- 任务列表 -->
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Width="44" Height="44"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                            <Setter Property="Background" Value="#EFF0FA"/>
                                            <Setter Property="Content" Value="◯"/>
                                            <Setter Property="FontSize" Value="22"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushSub}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Completed}" Value="True">
                                                    <Setter Property="Background" Value="#E4F7EC"/>
                                                    <Setter Property="Content" Value="✓"/>
                                                    <Setter Property="Foreground" Value="#1FA35C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Border Grid.Column="1" Width="48" Height="48" CornerRadius="13" Background="#F0F1FB" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource BrushSub}"
                                               Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="500"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#FFF6E5" CornerRadius="10" Padding="12,5" HorizontalAlignment="Right">
                                        <TextBlock Foreground="#D97B00" FontSize="14" FontWeight="Bold">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="+{0} 分">
                                                    <Binding Path="Points"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="✎" Style="{StaticResource IconButton}" ToolTip="编辑"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="🗑" Style="{StaticResource DangerIconButton}" ToolTip="删除"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 空状态 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="40,34" Visibility="{Binding Items.Count, Converter={StaticResource ZeroToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🗓️" FontSize="44" HorizontalAlignment="Center"/>
                    <TextBlock Text="这一天还没有每日任务，点击右上角添加吧！" Foreground="{StaticResource BrushSub}" FontSize="14" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
