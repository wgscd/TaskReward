<UserControl x:Class="TaskReward.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <!-- 标题 -->
            <TextBlock Text="欢迎回来，小主人 👋" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="坚持完成每一个小目标，积少成多，成为更好的自己！" Foreground="{StaticResource BrushSub}" FontSize="14" Margin="0,6,0,0"/>

            <!-- Hero 卡片 -->
            <Border Margin="0,18,0,0" CornerRadius="22" Background="{StaticResource GradPrimary}" Padding="30,26">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="5" Opacity="0.25" Color="#4B35A8"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="当前可用积分" Foreground="#CFD2FF" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding PointsText}" Foreground="#FFD97A" FontSize="52" FontWeight="Bold"/>
                            <TextBlock Text="分" Foreground="#FFD97A" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="8,0,0,10"/>
                        </StackPanel>
                        <TextBlock Foreground="#B9BDE8" FontSize="13" Margin="0,8,0,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="历史累计获得 {0} 分 · 当前称号：{1}">
                                    <Binding Path="LifetimeText"/>
                                    <Binding Path="CurrentRankName"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <!-- 下一成就进度环（简化用竖版） -->
                    <Border Grid.Column="1" Width="180" CornerRadius="16" Background="#22FFFFFF" Padding="18,14" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding NextAchName}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <ProgressBar Value="{Binding NextAchProgress, Mode=OneWay}" Style="{StaticResource GoldProgress}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding NextAchText}" Foreground="#FFD97A" FontSize="14" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 统计卡 -->
            <ItemsControl Margin="0,18,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Items>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="📋 今日已完成" FontSize="14" Foreground="{StaticResource BrushSub}"/>
                            <TextBlock Text="{Binding TodayDone}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushText}" Margin="0,8,0,0"/>
                            <TextBlock Text="项每日任务" FontSize="12" Foreground="{StaticResource BrushSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="🗂️ 我的任务" FontSize="14" Foreground="{StaticResource BrushSub}"/>
                            <TextBlock Text="{Binding TaskDoneText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushText}" Margin="0,8,0,0"/>
                            <TextBlock Text="已完成 / 总数" FontSize="12" Foreground="{StaticResource BrushSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="🎁 商城好物" FontSize="14" Foreground="{StaticResource BrushSub}"/>
                            <TextBlock Text="{Binding ProductCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource BrushText}" Margin="0,8,0,0"/>
                            <TextBlock Text="件可兑换" FontSize="12" Foreground="{StaticResource BrushSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="🏆 成就进度" FontSize="14" Foreground="{StaticResource BrushSub}"/>
                            <TextBlock Foreground="{StaticResource BrushText}" Margin="0,8,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} / {1}">
                                        <Binding Path="AchUnlocked"/>
                                        <Binding Path="AchTotal"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="枚已解锁" FontSize="12" Foreground="{StaticResource BrushSub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </ItemsControl.Items>
            </ItemsControl>

            <!-- 使用小贴士 -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="💡 成长小贴士" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="· 点击左侧「我的任务」添加任务，完成后打勾即可获得积分；" Foreground="{StaticResource BrushText}" FontSize="14" Margin="0,12,0,0"/>
                    <TextBlock Text="· 用「任务模板」可以快速添加常用任务；" Foreground="{StaticResource BrushText}" FontSize="14" Margin="0,8,0,0"/>
                    <TextBlock Text="· 攒够积分后，去「积分商城」兑换心仪的奖励；" Foreground="{StaticResource BrushText}" FontSize="14" Margin="0,8,0,0"/>
                    <TextBlock Text="· 每完成一项任务，历史积分都会累计，解锁更高成就！" Foreground="{StaticResource BrushText}" FontSize="14" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
